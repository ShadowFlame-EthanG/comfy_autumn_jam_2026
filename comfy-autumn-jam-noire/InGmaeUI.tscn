offset_right = 872.0
offset_bottom = 802.0
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("3_qjqth")
theme_override_font_sizes/normal_font_size = 24
text = "Finally, all pictures of the Subject were missing. Family portraits, self-photos, photos with friends. The Subject had been torn and ripped out of them all. Attached is the only surviving photo of the Subject, surrendered to the police by her sister.

Conclusion:

Because the door was locked, we conclude that the prime suspect is anyone who possesses a copy of the keys. Our investigation uncovered that there is only one copy, and it belongs to one Margaret Woodman, the sister of the Subject. "

