[node name="RichTextLabel" type="RichTextLabel" parent="TextureRect3" unique_id=1433631851]
layout_mode = 0
offset_left = 466.0
offset_top = 194.0
offset_right = 872.0
offset_bottom = 802.0
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("3_qjqth")
theme_override_font_sizes/normal_font_size = 23
text = "In the bathroom, among shards of broken glass, was a tube of uncapped lipstick. It had a dent on the bottom, as if it had fallen and hit the ground. Our conclusion: The attacker interrupted the victim whilst she was preparing to leave.


There was also a small, folding hand mirror on the bathroom floor near the tube of lipstick. This one was completely intact, unlike the other mirrors. We assume she was surprised, and dropped it along with the lipstick.

A thorough search of the apartment revealed the suspect was definitely not inside. There only door is the front, which was locked, and all the windows were also locked from the inside."

