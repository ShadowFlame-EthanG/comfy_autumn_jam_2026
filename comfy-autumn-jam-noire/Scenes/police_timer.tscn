[sub_resource type="GDScript" id="GDScript_mf63r"]
script/source = "extends Control

var total_time: int = 60 * 10

var started = false
func _ready() -> void:
	NarrationManager.dialogue_finished.connect(it_begins)
	


func _on_timer_timeout() -> void:
	total_time -= 1
	var m = int(total_time / 60.0)
	var s = total_time - m * 60
	$Label.text = '%02d:%02d' % [m,s]

func it_begins() -> void:
	if started == false:
		visible = true
		$Timer.start()
		started = true
"

