[sub_resource type="GDScript" id="GDScript_ha0tk"]
script/source = "extends Control

@onready var margaret = $PortraitDisplay/Margaret
@onready var waitress = $PortraitDisplay/Waitress

func _ready() -> void:
	NarrationManager.dialogue_engaged.connect(talking)
	NarrationManager.dialogue_finished.connect(done_talking)
	NarrationManager.picture_change.connect(which_picture)
	TransitionScreen.on_transition_finished.connect(no_picture)
	
func which_picture(name) -> void:
	if name == \"Margaret\":
		margaret.visible = true
		waitress.visible = false
	if name == \"Waitress\":
		margaret.visible = false
		waitress.visible = true

func no_picture() -> void:
	if NarrationManager.final_scene == true:
		margaret.visible = false
		waitress.visible = false

func talking():
	show()
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE

func done_talking():
	hide()
"

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_j7oc2"]

[sub_resource type="GDScript" id="GDScript_syjhi"]
script/source = "extends VBoxContainer
@export var narration_text: PackedScene



var newline_text
var curline_text

func _ready() -> void:
	NarrationManager.continued.connect(update_dialogue)
	NarrationManager.dialogue_engaged.connect(new_dialogue)
	
	
func new_dialogue() -> void:
	for child in get_children():
		child.queue_free()

func update_dialogue(text: String, _tags) -> void:
	if text.strip_edges(true, true).length() > 0:
		newline_text = narration_text.instantiate()
		if curline_text == null:
			curline_text = newline_text
			curline_text.line = text
			add_child(curline_text)
		else:
			curline_text.queue_free()
			curline_text = newline_text
			curline_text.line = text
			add_child(curline_text)
"

[sub_resource type="GDScript" id="GDScript_ow48a"]
script/source = "extends VBoxContainer
@export var choice_widget: PackedScene

func _ready() -> void:
	NarrationManager.dialogue_engaged.connect(start_dialogue)
	NarrationManager.continued.connect(update_dialogue)
	
func start_dialogue() -> void:
	for child in get_children():
		child.queue_free()

func update_dialogue(_text, _tags) -> void:
	if NarrationManager.has_choices:
		visible = true
		for child in get_children():
			child.queue_free()
		for choice in NarrationManager.current_choices:
			var new_choice = choice_widget.instantiate()
			new_choice.choice = choice
			add_child(new_choice)
	else:
		visible = false
		for child in get_children():
			child.queue_free()
			
"

