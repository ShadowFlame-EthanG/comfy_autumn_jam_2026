[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_f6flb"]

[sub_resource type="GDScript" id="GDScript_28flt"]
script/source = "extends PanelContainer

@onready var menu = $HBoxContainer/Menu
@onready var settings = $HBoxContainer/Panels/SettingsPanel
@onready var credits = $TextureRect2

func _ready() -> void:
	menu.visible = true
	


func _on_settings_button_pressed() -> void:
	if settings.visible == false:
		settings.visible = true
		if credits.visible == true:
			credits.visible = false
	else:
		settings.visible = false


func _on_credits_button_pressed() -> void:
	if credits.visible == false:
		credits.visible = true
		if settings.visible == true:
			settings.visible = false
	else:
		credits.visible = false
"

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_1ehe0"]
