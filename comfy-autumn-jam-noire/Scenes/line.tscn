[sub_resource type="GDScript" id="GDScript_pb32r"]
script/source = "extends Control
var _line: String
@onready var timer = $Timer

var line: String :
	set(val):
		_line = val
		%Label.text = _line
	get:
		return _line
	
func _ready() -> void:
	animate_label()
	NarrationManager.skipping.connect(skipped)

func _on_timer_timeout() -> void:
	if %Label.visible_characters == %Label.text.length() - 1:
		NarrationManager.skipped += 1
		print(NarrationManager.skipped)
	else:
		animate_label()

func animate_label() -> void:
	%Label.visible_characters += 1
	$AudioStreamPlayer.play()
	
	if %Label.visible_ratio != 1.0:
		timer.start()

func skipped() -> void:
	if Modes.current_mode == Enums.GameplayMode.NARRATION:
		if %Label.visible_ratio != 1.0:
			%Label.visible_characters = -1
			timer.stop()
			NarrationManager.skipped += 1
			print(NarrationManager.skipped)
		else:
			NarrationManager.skipped += 1
			print(NarrationManager.skipped)
"

