[sub_resource type="GDScript" id="GDScript_28flt"]
script/source = "extends Node3D

@onready var diner_lights =  $Lights/DinerLights
@onready var street_lamps = $Lights/StreetLamps
@onready var choice_lights = $Lights/ChoiceLights
@onready var katie = $Characters/Katie_Rig_Sitting
@onready var dopp = $Characters/Dopp_Rig_Sitting_Necklace
@onready var margaret = $Characters/Sister_Rig_SittingHoldingCoffee2
@onready var files = $DinerObjects/TableObjects/Files
@onready var coffee = $DinerObjects/TableObjects/Coffee
@onready var newspaper = $DinerObjects/TableObjects/Newspaper


func _ready() -> void:
	$Timer.start()
	TransitionScreen.on_transition_finished.connect(change_lights)
	
func _on_timer_timeout() -> void:
	NarrationManager.start_dialogue(\"sister_intro\")
	

func change_lights() -> void:
	if NarrationManager.final_scene:
		diner_lights.visible = false
		street_lamps.visible = false
		margaret.visible = false
		newspaper.visible = false
		coffee.visible = false
		files.visible = false
		choice_lights.visible = true
		katie.visible = true
		dopp.visible = true
		NarrationManager.start_dialogue(\"the_choice\")
		$Characters/WaitressTimer.stop()
		$DinerAmbience.stop()
		$MusicController/Music.stop()
"

