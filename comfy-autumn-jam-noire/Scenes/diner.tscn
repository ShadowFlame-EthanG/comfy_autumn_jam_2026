[sub_resource type="GDScript" id="GDScript_28flt"]
script/source = "extends Node3D

@onready var diner_lights =  $Lights/DinerLights
@onready var street_lamps = $Lights/StreetLamps
@onready var choice_lights = $Lights/ChoiceLights
@onready var katie = $Characters/Katie_Rig_Sitting
@onready var dopp = $Characters/Dopp_Rig_Sitting_Necklace
@onready var margaret = $Characters/Sister_Rig_SittingHoldingCoffee2
@onready var files = $DinerObjects/TableObjects/Files
@onready var coffee = $DinerObjects/TableObjects/Coffee
@onready var newspaper = $DinerObjects/TableObjects/Newspaper
@onready var main_music: AudioStreamPlayer = $MusicController/Music
@onready var musicON = $Music_on
@onready var musicOFF = $Music_off
@onready var waitressSit = $Characters/Waitress_Rig_StoolSitting
@onready var waitressWipe = $Characters/Waitress_Rig_WipingCounter

func _ready() -> void:
	$Timer.start()
	TransitionScreen.on_transition_finished.connect(change_lights)
	NarrationManager.new_dialogue.connect(new_dialogue)
	main_music.play()
	musicON.start(167)
	main_music.volume_db = -80.0
	var tween = create_tween()
	tween.tween_property(main_music, \"volume_db\", 0.0, 3)
	
func _on_timer_timeout() -> void:
	NarrationManager.start_dialogue(\"sister_intro\")
	
func new_dialogue() -> void:
	if NarrationManager.new_talking == true:
		$New_Dialogue.play()
		NarrationManager.new_talking = false

func change_lights() -> void:
	$Narration/HideScreen.visible = true
	$MusicController/Music.stop()
	$DinerAmbience.stop()
	if NarrationManager.final_scene:
		$Narration/HideScreen.visible = false
		diner_lights.visible = false
		street_lamps.visible = false
		waitressSit.visible = false
		waitressWipe.visible = false
		margaret.visible = false
		newspaper.visible = false
		coffee.visible = false
		files.visible = false
		choice_lights.visible = true
		katie.visible = true
		dopp.visible = true
		$Characters/WaitressTimer.stop()
		musicOFF.stop()
		musicON.stop()
		$MusicController/ChoiceMusic.play()

func start_music():
	print(\"music starting\")
	main_music.stop()
	main_music.play()
	musicON.start(167)
	main_music.volume_db = -80.0
	var tween = create_tween()
	tween.tween_property(main_music, \"volume_db\", 0.0, 10)

func stop_music():
	print(\"music stopping\")
	musicOFF.start(30)
	var tween = create_tween()
	tween.tween_property(main_music, \"volume_db\", -80.0, 10)

func _on_music_on_timeout() -> void:
	stop_music()


func _on_music_off_timeout() -> void:
	start_music()
"

